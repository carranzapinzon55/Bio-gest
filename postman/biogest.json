    {
      "name": "1. Autenticación",
      "description": "Endpoints públicos y protegidos para inicio de sesión, registro de clientes, consulta de perfil y cierre de sesión con tokens Laravel Sanctum.",
      "item": [
        {
          "name": "POST /api/login (Administrador / Cliente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 200 && jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Token Sanctum guardado exitosamente:\", jsonData.data.token);",
                  "} else {",
                  "    console.warn(\"No se pudo extraer el token de la respuesta.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@tenebriosgold.com\",\n  \"contrasena\": \"Admin123*\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/login",
              "host": ["{{base_url}}"],
              "path": ["login"]
            },
            "description": "Inicia sesión con correo y contraseña. Devuelve un Bearer Token Sanctum que se asigna automáticamente a la variable {{token}}."
          },
          "response": [
            {
              "name": "200 - Login Exitoso",
              "originalRequest": {
                "method": "POST",
                "header": [
                  { "key": "Accept", "value": "application/json" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"correo\": \"admin@tenebriosgold.com\",\n  \"contrasena\": \"Admin123*\"\n}"
                },
                "url": { "raw": "{{base_url}}/login", "host": ["{{base_url}}"], "path": ["login"] }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"success\": true,\n  \"message\": \"Inicio de sesión exitoso.\",\n  \"data\": {\n    \"token\": \"1|8vH2zX9qL4mN7pR1tY5wU3eI6oA0sD2fG4hJ8kL1\",\n    \"token_type\": \"Bearer\",\n    \"usuario\": {\n      \"id_usuario\": 1,\n      \"nombre\": \"Administrador\",\n      \"apellido\": \"BIO-GEST\",\n      \"nombre_completo\": \"Administrador BIO-GEST\",\n      \"correo\": \"admin@tenebriosgold.com\",\n      \"telefono\": \"3001234567\",\n      \"id_rol\": 1,\n      \"rol\": \"Administrador\",\n      \"perfil_uso\": \"Proyecto comercial / Gran escala\",\n      \"estado\": \"Activo\"\n    }\n  }\n}"
            },
